DATABASE_URL=postgresql://nexus_app:local-app-only@127.0.0.1:55432/nexus
MIGRATION_DATABASE_URL=postgresql://postgres:local-db-only@127.0.0.1:55432/nexus
BETTER_AUTH_URL=http://127.0.0.1:3000
BETTER_AUTH_SECRET=

# Optional Anthropic study pilot. Enable for one approved institution only.
# Set verified model pricing in USD per million tokens and a rolling 24h cap in millionths of USD.
ANTHROPIC_API_KEY=
AURA_TUTOR_INSTITUTION=
AURA_TUTOR_MODEL=
AURA_INPUT_USD_PER_MTOK=
AURA_OUTPUT_USD_PER_MTOK=
AURA_DAILY_MICROUSD=

# Optional free-text AURA pilot. Disabled by default. Requires an approved data policy,
# verified model IDs, current prices, institution allowlist and spending limits.
AURA_MODEL_ENABLED=false
AURA_MODEL_ROUTINE=
AURA_MODEL_COMPLEX=
AURA_MODEL_INSTITUTIONS=
AURA_MODEL_PRICES=
AURA_TOTAL_CAP_USD=
AURA_DAILY_INSTITUTION_CAP_USD=
AURA_PER_CALL_CAP_USD=

# Required for remote connections. Use password-free endpoint URIs independently verified
# against the dedicated NEXUS provider project. Include the exact port, role and database.
# Full secret connection URLs must use ?sslmode=verify-full.
NEXUS_RUNTIME_TARGET=
NEXUS_MIGRATION_TARGET=
